generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Tabla simple para probar la conexión
model TestConnection {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
}
